# Database (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Site URL - ضع دومينك هنا عند التركيب (مهم للإيميلات والـ SEO)
# مثال: https://maison-douce.ma أو https://www.maison-douce.ma
NEXT_PUBLIC_SITE_URL=https://maison-douce.com

# Admin password for /admin dashboard
ADMIN_PASSWORD=douce2026
# Optional: same as above but accessible client side for faster check
NEXT_PUBLIC_ADMIN_PASSWORD=douce2026

# ============ OPTION B - Email Setup (اختر واحدة) ============

# Option B-1: Resend (موصى به للدومين - مجاني 100 إيميل/يوم، 3000/شهر)
# سجل في https://resend.com - أضف دومينك - خذ API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Maison Douce <orders@maison-douce.com>

# Option B-2: SMTP (Gmail, Hostinger, etc) - بديل إذا ما بغيتيش Resend
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com, SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Maison Douce <noreply@maison-douce.com>

# ===============================================================
# Email destination (where orders go)
# Currently hardcoded to nizarbks59@gmail.com in code, but you can make it env:
# ORDER_EMAIL=nizarbks59@gmail.com
